{
  "name": "sport-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sport Sim App - iPhone-first pro-football GM career RPG (Package A foundation)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "golden:check": "tsx packages/headless/src/bin.ts golden",
    "golden:write": "tsx packages/headless/src/bin.ts golden --write",
    "golden:package-b:check": "tsx packages/headless/src/bin.ts package-b-golden",
    "golden:package-b:write": "tsx packages/headless/src/bin.ts package-b-golden --write",
    "golden:package-c:check": "tsx packages/headless/src/bin.ts package-c-golden",
    "golden:package-c:write": "tsx packages/headless/src/bin.ts package-c-golden --write",
    "golden:package-d:check": "tsx packages/headless/src/bin.ts package-d-golden",
    "golden:package-d:write": "tsx packages/headless/src/bin.ts package-d-golden --write",
    "export:ios": "npm run export:ios --workspace apps/mobile",
    "ci": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run golden:check && npm run golden:package-b:check && npm run golden:package-c:check && npm run golden:package-d:check && npm run export:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "eslint-import-resolver-typescript": "3.10.1"
  }
}
